{
  "expo": {
    "name": "Brighton Lawn + Landscape",
    "slug": "brighton-lawn-landscape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "brighton-lawn",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brightonlawn.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo-icon.png"
      },
      "package": "com.brightonlawn.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Brighton Lawn to access your photos for profile pictures.",
          "cameraPermission": "Allow Brighton Lawn to use the camera for profile pictures."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo-full.png",
          "imageWidth": 240
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Brighton Lawn uses your location to check job site addresses on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c096c836-738b-4ef2-b926-2a10bfbe3891"
      }
    },
    "owner": "drakematcher"
  }
}
